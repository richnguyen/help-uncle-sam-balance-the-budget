{
  "name": "help-uncle-sam-balance-the-budget",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A plain-language guide to U.S. federal spending, revenue, deficits and debt, built from official government data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "vite build --mode artifact && node scripts/make-artifact.mjs",
    "preview": "vite preview",
    "check-hosts": "NODE_USE_ENV_PROXY=1 node scripts/check-hosts.mjs",
    "data": "NODE_USE_ENV_PROXY=1 node scripts/fetch-all.mjs && node scripts/build-data.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:county": "NODE_USE_ENV_PROXY=1 node scripts/fetch-county-tax.mjs",
    "voice:collect": "node scripts/voice/collect.mjs http://localhost:5173/",
    "voice:synth": "python3 scripts/voice/synth.py scripts/voice/lines.json ${KOKORO_DIR:-.kokoro} public/voice src/data/generated/voice.json",
    "test:db": "node supabase/tests/rls.test.mjs",
    "previews": "node scripts/make-previews.mjs http://localhost:5173/",
    "news": "node scripts/fetch-news.mjs",
    "dts": "node scripts/fetch-dts.mjs",
    "test:rollcall": "node scripts/rollcall.test.mjs",
    "test:alerts": "node --experimental-strip-types --no-warnings supabase/tests/bill-alerts.test.mts",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:full": "node tests/e2e/run.mjs --tier full",
    "state-pages": "node scripts/make-state-pages.mjs --images",
    "test:social": "node scripts/social/posts.test.mjs",
    "social:drafts": "node scripts/social/compose.mjs"
  },
  "dependencies": {
    "d3": "7.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@types/d3": "7.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4"
  }
}
