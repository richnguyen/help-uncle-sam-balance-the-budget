{
  "name": "Help Uncle Sam Balance the Budget",
  "short_name": "Uncle Sam",
  "description": "A civic game about the federal budget: 21 short missions on where the money goes, why the government borrows, and how you would fix it, built on official U.S. government data.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "lang": "en-US",
  "dir": "ltr",
  "display": "standalone",
  "orientation": "natural",
  "background_color": "#f2f4ef",
  "theme_color": "#1d5a43",
  "categories": [
    "education",
    "games"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "icons": [
